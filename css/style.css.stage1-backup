:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#1e2d27;background:#f5f7f5;font-synthesis:none;text-rendering:optimizeLegibility;--green:#176b49;--dark:#123b2c;--muted:#75827b;--border:#e5ebe6}
*{box-sizing:border-box}body{margin:0;min-height:100vh}button,input,select,textarea{font:inherit}button{cursor:pointer}.sidebar{position:fixed;inset:0 auto 0 0;width:245px;background:var(--dark);color:white;padding:26px 16px;display:flex;flex-direction:column;z-index:5}.brand{display:flex;align-items:center;gap:12px;padding:0 8px 35px}.brand-mark{height:43px;width:47px;border-radius:12px;background:#d7f1df;color:#165238;display:grid;place-items:center;font-weight:850;font-size:14px}.brand strong,.brand small,.sidebar-bottom strong,.sidebar-bottom small{display:block}.brand strong{font-size:17px}.brand small,.sidebar-bottom small{color:#b8d0c2;font-size:11px;margin-top:4px}.nav-label,.eyebrow{font-size:10px;font-weight:800;letter-spacing:1.5px;color:#9eaea4}.nav-label{padding:0 12px;margin-bottom:12px}.sidebar nav{display:grid;gap:7px}.nav-link{border:0;text-align:left;padding:13px 12px;border-radius:9px;background:transparent;color:#d4e3d9;display:flex;gap:12px;align-items:center;font-size:14px}.nav-link.active,.nav-link:hover{background:#245641;color:white}.nav-link span{font-weight:550}.sidebar-bottom{margin-top:auto;border-top:1px solid #315542;padding:20px 8px 0;display:flex;align-items:center;gap:10px;font-size:12px}.status-dot{width:9px;height:9px;border-radius:50%;background:#67d69a}.main{margin-left:245px;padding:0 32px;max-width:1800px}.topbar{height:105px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);margin-bottom:27px}.topbar .eyebrow{color:#849188;margin:0 0 7px}.topbar h1{font-size:25px;margin:0;letter-spacing:-.7px}.top-right{display:flex;align-items:center;gap:14px}.demo-tag{font-size:10px;font-weight:800;letter-spacing:1px;padding:7px 10px;border-radius:6px;background:#fff0cf;color:#93631c}.avatar{height:36px;width:36px;border-radius:50%;display:grid;place-items:center;background:#d9eadf;color:#245641;font-weight:800}.page{display:none}.page.active-page{display:block}.welcome{background:linear-gradient(115deg,#123b2c,#236747);border-radius:15px;padding:28px 30px;color:white;display:flex;align-items:center;justify-content:space-between;gap:20px}.welcome .eyebrow{color:#b9d9c4;margin:0 0 10px}.welcome h2{font-size:23px;margin:0 0 8px;letter-spacing:-.5px}.welcome p:last-child{color:#d1e3d7;font-size:13px;margin:0}.primary-btn,.secondary-btn{border:0;border-radius:8px;padding:11px 16px;font-weight:700;font-size:12px;white-space:nowrap}.primary-btn{background:var(--green);color:white}.primary-btn:hover{background:#10553a}.welcome .primary-btn{background:#fff;color:#175239}.secondary-btn{background:#edf1ed;color:#34463b}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin:29px 0 16px}.section-heading h2,.panel h2{font-size:16px;margin:0 0 6px}.section-heading p,.panel-heading p,.form-intro p{font-size:12px;color:var(--muted);margin:0}.period{font-size:11px;background:#fff;border:1px solid var(--border);padding:9px 12px;border-radius:7px;color:#647169}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:24px}.metric-card,.panel,.unit-card{background:#fff;border:1px solid var(--border);border-radius:12px}.metric-card{padding:18px;min-width:0}.metric-icon{height:35px;width:35px;border-radius:9px;display:grid;place-items:center;font-weight:800}.green{background:#e3f5e9;color:#287a4d}.blue{background:#e6efff;color:#4268b2}.orange{background:#fff0df;color:#aa702b}.purple{background:#f1e8ff;color:#8152b0}.metric-card>p{font-size:12px;color:#6e7a72;margin:15px 0 5px}.metric-card h3{font-size:24px;margin:0;letter-spacing:-.6px;overflow-wrap:anywhere}.metric-card>small{font-size:10px;color:#929b95;display:block;margin-top:8px}.content-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:18px}.panel{padding:21px;margin-bottom:18px;min-width:0}.panel-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.unit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.unit-card{padding:15px;transition:border-color .15s,transform .15s}.unit-card:hover{border-color:#a5cdb4;transform:translateY(-1px)}.unit-symbol{width:34px;height:34px;border-radius:9px;background:#e8f4eb;color:#2a714a;display:grid;place-items:center;font-weight:800;margin-bottom:12px}.unit-card h3{font-size:13px;margin:0 0 6px}.unit-card p{font-size:11px;line-height:1.6;color:var(--muted);margin:0}.unit-card button{border:0;background:none;color:var(--green);font-weight:700;font-size:11px;padding:12px 0 0}.recent-list{display:grid;gap:0}.recent-item{display:flex;justify-content:space-between;gap:10px;padding:13px 0;border-bottom:1px solid #eef1ee}.recent-item:last-child{border:0}.recent-item strong{font-size:12px;display:block}.recent-item small{display:block;color:var(--muted);font-size:10px;margin-top:5px}.recent-amount{text-align:right;font-size:12px;font-weight:800;white-space:nowrap}.empty-state{padding:28px 10px;text-align:center;color:#849188;font-size:12px;line-height:1.7}.notice{font-size:11px;color:#8a7954;background:#fff8e8;border:1px solid #f1e6c7;padding:13px 15px;border-radius:8px;margin:5px 0 20px}.large-grid{grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:22px}.large-grid .unit-card{padding:20px}.table-panel{padding:0;overflow:hidden}.table-panel .panel-heading{padding:21px 21px 0}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;white-space:nowrap}th,td{padding:14px 18px;border-bottom:1px solid #edf0ed;font-size:12px}th{color:#7b877f;font-weight:650;background:#fafbfa}td{color:#435249}td:last-child{font-weight:650}.form-panel{max-width:900px}.form-intro{padding-bottom:20px;border-bottom:1px solid var(--border);margin-bottom:20px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.form-grid label{display:grid;gap:8px;font-size:12px;font-weight:650;color:#34483c}.form-grid input,.form-grid select,.form-grid textarea{width:100%;min-width:0;padding:11px 12px;border:1px solid #dce4dd;border-radius:7px;background:#fff;color:#26382e;outline:none;font-size:12px}.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus{border-color:#5b9b74;box-shadow:0 0 0 3px #e7f4eb}.full-field{grid-column:1/-1}.form-grid textarea{resize:vertical}.form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}.form-message{font-size:12px;color:var(--green)}.muted{font-size:13px;line-height:1.8;color:var(--muted);margin:12px 0 18px}footer{padding:24px 0 30px;color:#9aa39d;font-size:10px;text-align:center}
@media(max-width:1100px){.sidebar{width:205px}.main{margin-left:205px;padding:0 22px}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.content-grid{grid-template-columns:1fr}.large-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.sidebar{position:static;width:100%;padding:12px;display:block}.brand{padding:0 4px 12px}.brand-mark{height:35px;width:40px}.nav-label,.sidebar-bottom{display:none}.sidebar nav{display:flex;overflow-x:auto;gap:5px;padding-bottom:3px}.nav-link{flex:0 0 auto;padding:10px;font-size:12px}.nav-link span{white-space:nowrap}.main{margin:0;padding:0 14px}.topbar{height:83px;margin-bottom:17px}.topbar h1{font-size:20px}.welcome{padding:22px;align-items:flex-start;flex-direction:column}.welcome h2{font-size:20px}.section-heading{align-items:flex-start}.metrics{gap:10px}.metric-card{padding:13px}.metric-card h3{font-size:20px}.unit-grid,.large-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:15px}.form-grid{grid-template-columns:1fr}.full-field{grid-column:auto}.period{display:none}}
@media(max-width:390px){.unit-grid,.large-grid{grid-template-columns:1fr}.demo-tag{display:none}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}

.upload-label{display:grid;gap:10px;font-size:12px;font-weight:700;color:#34483c;margin:16px 0}
.upload-label input{width:100%;padding:12px;border:1px dashed #a9c5b2;border-radius:8px;background:#f8fbf8;font-size:12px}
#csv-preview{margin-top:14px}
#csv-preview:empty{display:none}
#csv-preview table{margin-bottom:10px}
#csv-preview .muted{font-size:11px}
#csv-preview .form-message{line-height:1.8;color:#a15b2b}
button:disabled{opacity:.45;cursor:not-allowed}
